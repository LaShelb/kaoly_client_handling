#!/bin/sh
# faux gh : rien ne sort. « pr create » échoue tant que le fichier $FAUX_GH_PANNE existe ; « pr view » dit MERGED si $FAUX_GH_FUSIONNEE existe.
echo "gh $*" >> "${FAUX_LOG:-$(dirname "$0")}/gh.log"
case "$1 $2" in
  "pr create") [ -n "$FAUX_GH_PANNE" ] && [ -e "$FAUX_GH_PANNE" ] && { echo "pull request create failed: faux" >&2; exit 1; }
    echo "https://github.com/x/y/pull/1";;
  "pr view") if [ -n "$FAUX_GH_FUSIONNEE" ] && [ -e "$FAUX_GH_FUSIONNEE" ]; then echo MERGED; else echo OPEN; fi;;
  "repo clone") echo "faux gh : pas de clonage" >&2; exit 1;;
esac
exit 0
