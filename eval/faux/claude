#!/bin/sh
# faux Claude Code : aucun appel réel. Repères dans le texte : [BUCKWELL] ou [GARONNE] (client), [QUESTION], [VISIBLE], [RIEN] (aucun changement), [LENT],
# [FORGE] (la barre tente d'imposer pièces jointes et expéditeur), [DOUBLE] (deux demandes identiques). Le travail échoue tant que $FAUX_CLAUDE_PANNE existe.
L="${FAUX_LOG:-$(dirname "$0")}"
# comptes : « auth status » dit un abonnement connecté, « auth login » et « auth logout » ne font rien
case "$1" in auth) [ "$2" = status ] && echo '{"loggedIn":true,"authMethod":"claude.ai","email":"simon@kaoly.fr","subscriptionType":"max"}'; exit 0;; esac
case "$*" in *stream-json*) ;; *)
  # tri des messages entrants (relève) ; échoue si le fichier $FAUX_TRI_PANNE existe
  case "$*" in *"Tu tries les messages"*)
    [ -n "$FAUX_TRI_PANNE" ] && [ -e "$FAUX_TRI_PANNE" ] && { echo '{"is_error":true,"result":"tri en panne"}'; exit 0; }
    echo '{"is_error":false,"structured_output":{"tickets":[{"msg":0,"title":"Export cassé","request":"L export ne marche plus depuis hier.","kind":"bug"}]}}'; exit 0;; esac
  # barre de commande (le texte envoyé est gardé pour le banc)
  printf '%s' "$*" > "$L/barre.txt"
  C=arion; case "$*" in *"[BUCKWELL]"*) C=buckwell;; *"[GARONNE]"*) C=garonne;; esac
  X=""; case "$*" in *"[FORGE]"*) X=',"files":["/etc/hosts"],"source":{"channel":"mail","from":"pirate@evil.example"}';; esac
  M=""; for k in QUESTION RIEN VISIBLE LENT DOUBLE; do case "$*" in *"[$k]"*) M="$M [$k]";; esac; done
  T="{\"type\":\"create_ticket\",\"clientId\":\"$C\",\"title\":\"Titre <img src=x onerror=alert(1)>\",\"request\":\"Le titre est faux <script>alert(1)</script>$M\",\"kind\":\"bug\"$X}"
  case "$*" in *"[DOUBLE]"*) T="$T,$T";; esac
  echo "{\"is_error\":false,\"structured_output\":{\"reply\":\"C'est noté.\",\"actions\":[$T,{\"type\":\"update_client\",\"id\":\"arion\",\"autoProd\":true}]}}"
  exit 0;; esac
echo "travail" >> "$L/claude.log"
printf '%s' "$*" > "$L/prompt.txt"
[ -n "$FAUX_CLAUDE_PANNE" ] && [ -e "$FAUX_CLAUDE_PANNE" ] && { echo "faux : panne" >&2; exit 1; }
case "$*" in *"[LENT]"*) sleep 4;; esac
P=$(echo "$*" | sed -n 's/.*--add-dir \([^ ]*\/preuves\/[^ ]*\).*/\1/p')
echo '{"type":"system","subtype":"init","session_id":"sess-1"}'
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Je corrige le titre."},{"type":"tool_use","name":"Edit","input":{"file_path":"index.html"}}]}}'
case "$*" in *"[QUESTION]"*)
  echo '{"type":"result","is_error":false,"structured_output":{"status":"question","kind":"bug","summary":"Bloqué","change":"","reserve":"","question":"Quel titre ?","options":["Garde Bonjour","Mets Bienvenue"],"message":{"subject":"","body":""}}}'; exit 0;; esac
K=bug; case "$*" in *"[VISIBLE]"*) K=visible;; esac
case "$*" in *"[RIEN]"*) K=question;; *)
  echo "<p>modifié $$</p>" >> index.html
  printf 'PNG' > "$P/avant-titre.png"; printf 'PNG' > "$P/apres-titre.png";; esac
echo "{\"type\":\"result\",\"is_error\":false,\"structured_output\":{\"status\":\"fait\",\"kind\":\"$K\",\"summary\":\"Titre corrigé, vérifié en local.\",\"change\":\"Le titre de la page d'accueil dit Bonjour.\",\"reserve\":\"\",\"message\":{\"subject\":\"Titre corrigé\",\"body\":\"Bonjour, c'est corrigé. Simon\"}}}"
